#!/usr/bin/env bash
set -euo pipefail

timeout=5
elapsed=0

while [ ! -f tmp/executor/service.pid ]; do
    sleep 1
    elapsed=$((elapsed + 1))
    if [ "$elapsed" -ge "$timeout" ]; then
        echo "Timeout reached: tmp/executor/service.pid not found"
        exit 1
    fi
done

pid=$(cat tmp/executor/service.pid)
kill -TERM "$pid"


while [ -f tmp/executor/service.pid ]; do
    sleep 1
    elapsed=$((elapsed + 1))
    if [ "$elapsed" -ge "$timeout" ]; then
        echo "Timeout reached: tmp/executor/service.pid was not removed"
        exit 1
    fi
done


# vim: ft=sh
